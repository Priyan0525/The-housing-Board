async function setWaterDuty(day, slotIndex, memberId){
  const water = (await sget('water-schedule', true)) || {};
  const pair = water[day] ? [...water[day]] : [null, null];
  pair[slotIndex] = memberId || null;
  water[day] = pair;
  const ok = await sset('water-schedule', water, true);
  if(ok) state.water = water;
  render();
}
async function autoAssignWater(){
  if(!isAdminNow()) return;
  const ids = state.members.map(m=>m.id);
  const water = {};
  let cursor = 0;
  WEEKDAYS.forEach(day=>{
    const a = ids[cursor % ids.length];
    const b = ids[(cursor+1) % ids.length];
    water[day] = [a, b];
    cursor += 2;
  });
  const ok = await sset('water-schedule', water, true);
  if(ok) state.water = water;
  render();
}

