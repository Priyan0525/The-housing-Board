<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Room 12 — House Board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-top:#E6EBF3;
    --bg-bottom:#F3F5F9;
    --ink:#101828;
    --ink-soft:#5A6479;
    --card:#FFFFFF;
    --line: rgba(16,24,40,0.08);
    --blue:#2F6FED;
    --amber:#F2A93B;
    --paid:#3E9C5E;
    --unpaid:#E15B4E;
    --shadow: 0 6px 18px rgba(16,24,40,0.07);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg-bottom);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    min-height:100vh;
    display:flex;
    justify-content:center;
  }
  h1,h2,h3{font-family:'Poppins', sans-serif;}
  #app{
    width:100%;
    max-width:480px;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    background:linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 45%);
    position:relative;
  }

  /* ---- Header ---- */
  .plaque{
    padding:26px 20px 18px;
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:12px;
  }
  .plaque-num{
    display:inline-flex;
    align-items:center;gap:7px;
    background:var(--card);
    color:var(--ink);
    border-radius:22px;
    padding:9px 16px 9px 10px;
    font-weight:700;font-size:14px;
    box-shadow:var(--shadow);
    flex-shrink:0;
    white-space:nowrap;
  }
  .plaque-num .dot{width:26px;height:26px;border-radius:50%;background:var(--amber);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;}
  .plaque h1{font-size:32px;margin:0;color:var(--ink);font-weight:700;letter-spacing:-0.5px;}
  .plaque p{margin:4px 0 0;font-size:13px;color:var(--ink-soft);}

  /* ---- Generic layout ---- */
  main{flex:1;padding:6px 18px 110px;overflow-y:auto;}
  .card{
    background:var(--card);
    color:var(--ink);
    border-radius:16px;
    padding:18px;
    margin-bottom:14px;
    box-shadow:var(--shadow);
  }
  .card h3{margin:0 0 10px;font-size:16px;font-weight:600;}
  .muted{color:var(--ink-soft);font-size:12.5px;}
  label{display:block;font-size:12.5px;font-weight:600;margin:12px 0 5px;color:var(--ink);}
  .card label{color:var(--ink-soft);}
  input,select{
    width:100%;
    padding:11px 12px;
    border-radius:10px;
    border:1px solid #DDE2EC;
    background:#F8F9FC;
    font-family:inherit;
    font-size:14px;
    color:var(--ink);
  }
  button{
    font-family:inherit;
    cursor:pointer;
    border:none;
  }
  .btn-primary{
    background:var(--ink);
    color:#fff;
    font-weight:600;
    padding:13px 16px;
    border-radius:12px;
    width:100%;
    font-size:14.5px;
    margin-top:16px;
  }
  .btn-primary:disabled{opacity:0.5;cursor:not-allowed;}
  .btn-ghost{
    background:var(--card);
    border:1px solid var(--line);
    color:var(--ink);
    padding:11px 14px;
    border-radius:12px;
    font-size:13.5px;
    box-shadow:var(--shadow);
  }
  .btn-small{
    padding:8px 13px;
    border-radius:20px;
    font-size:12.5px;
    font-weight:600;
  }
  .row{display:flex;justify-content:space-between;align-items:center;}
  .divider{height:1px;background:var(--line);margin:14px 0;}
  .err{color:var(--unpaid);font-size:12.5px;margin-top:8px;}
  .center-screen{
    flex:1;display:flex;flex-direction:column;justify-content:center;padding:28px;
  }
  .center-screen h1{font-size:26px;margin-bottom:6px;font-weight:700;letter-spacing:-0.5px;}
  .center-screen .sub{color:var(--ink-soft);font-size:13.5px;margin-bottom:22px;}

  /* ---- Bottom nav ---- */
  nav{
    position:absolute;bottom:0;left:0;right:0;
    background:var(--card);
    border-top:1px solid var(--line);
    display:flex;
    padding:10px 6px calc(10px + env(safe-area-inset-bottom));
  }
  nav button{
    flex:1;background:none;color:#9CA3B4;
    display:flex;flex-direction:column;align-items:center;gap:5px;
    font-size:10.5px;font-weight:600;padding:4px 2px;border-radius:6px;
  }
  nav button .ic{
    width:32px;height:32px;border-radius:50%;
    background:#F1F3F8;
    display:flex;align-items:center;justify-content:center;
    font-size:15px;
  }
  nav button.active{color:var(--blue);}
  nav button.active .ic{background:#E7EFFE;}

  /* member row list */
  .member-row{
    display:flex;justify-content:space-between;align-items:center;
    padding:10px 0;border-bottom:1px solid var(--line);
  }
  .member-row:last-child{border-bottom:none;}
  .badge{
    font-size:11px;font-weight:600;padding:5px 11px;border-radius:20px;color:#fff;
  }
  .badge.paid{background:var(--paid);}
  .badge.unpaid{background:var(--unpaid);}
  .badge.free{background:#9CA3B4;}

  .slot-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .slot-card{
    border:1.5px solid var(--line);border-radius:14px;padding:14px;text-align:center;
  }
  .slot-card.taken{background:#F5F6FA;}
  .slot-card .num{font-family:'Poppins',sans-serif;font-size:20px;font-weight:700;}

  .setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
  .weekday-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--line);gap:10px;}
  .weekday-row:last-child{border-bottom:none;}
  .weekday-row .day{font-weight:600;width:44px;flex-shrink:0;}
  .loading{padding:40px 20px;text-align:center;color:var(--ink-soft);}
  .toast{
    position:absolute;top:14px;left:14px;right:14px;
    background:var(--unpaid);color:#fff;
    padding:11px 14px;border-radius:12px;
    font-size:13px;text-align:center;
    z-index:50;
    transition:opacity 0.4s;
    box-shadow:0 4px 14px rgba(0,0,0,0.2);
  }

  /* ---- Empty state ---- */
  .empty-state{
    display:flex;flex-direction:column;align-items:center;
    text-align:center;padding:34px 12px 10px;
  }
  .empty-state .circle{
    width:110px;height:110px;border-radius:50%;
    background:#EBEDF3;
    display:flex;align-items:center;justify-content:center;
    font-size:40px;
    margin-bottom:22px;
  }
  .empty-state h3{font-size:19px;margin:0 0 6px;font-weight:700;}
  .empty-state p{color:var(--ink-soft);font-size:13.5px;margin:0;line-height:1.5;}
</style>
</head>
<body>
<div id="app"><div class="loading" id="initial-loading">Opening the house board…</div></div>

<script>
const WEEKDAYS = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];

let state = {
  screen: 'loading',
  config: null,
  members: [],
  rentStatus: {},
  ebStatus: {},
  water: {},
  bookings: [],
  food: [],
  sessionMemberId: null,
  isAdminSession: false,
  gatePassed: false,
  tab: 'home',
  moneySub: 'rent',
  err: '',
};
let loginMode = 'member';
function isAdminNow(){ return state.isAdminSession; }

// ---------- storage helpers ----------
function withTimeout(promise, ms){
  return Promise.race([
    promise,
    new Promise((_, reject) => setTimeout(()=>reject(new Error('timeout')), ms))
  ]);
}
async function sget(key, shared){
  try{
    const r = await withTimeout(window.storage.get(key, shared), 8000);
    return r ? JSON.parse(r.value) : null;
  }catch(e){ return null; }
}
async function sset(key, value, shared, _isRetry){
  try{
    await withTimeout(window.storage.set(key, JSON.stringify(value), shared), 8000);
    return true;
  }catch(e){
    if(!_isRetry){
      await new Promise(r=>setTimeout(r, 900));
      return sset(key, value, shared, true);
    }
    console.error('storage set failed', key, e);
    showToast("Couldn't save that — check your connection and try again.");
    return false;
  }
}
function showToast(msg){
  const app = document.getElementById('app');
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = msg;
  app.appendChild(el);
  setTimeout(()=>{ el.style.opacity = '0'; }, 3200);
  setTimeout(()=>{ el.remove(); }, 3700);
}

function todayKey(){
  const d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
}
function nextMondayISO(){
  const d = new Date();
  const day = d.getDay(); // 0 Sun .. 6 Sat
  const diff = (8 - day) % 7 || 7;
  const nd = new Date(d);
  nd.setDate(d.getDate() + (day===1?0:diff===7&&day===1?0:diff));
  // simpler: find this/next Monday (if today is Monday, use today)
  const base = new Date(d);
  const offset = (day===1)?0:((8-day)%7);
  base.setDate(d.getDate()+offset);
  base.setHours(0,0,0,0);
  return base.toISOString().slice(0,10);
}
function fmtCountdown(ms){
  if(ms<0) ms=0;
  const h = Math.floor(ms/3600000);
  const m = Math.floor((ms%3600000)/60000);
  const s = Math.floor((ms%60000)/1000);
  return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
}
function bookingWindowInfo(){
  const [sh,sm] = state.config.bookingStart.split(':').map(Number);
  const [eh,em] = state.config.bookingEnd.split(':').map(Number);
  const now = new Date();
  const start = new Date(now); start.setHours(sh,sm,0,0);
  const end = new Date(now); end.setHours(eh,em,0,0);
  if(now>=start && now<=end) return {open:true, closesIn: end-now};
  let nextStart = start;
  if(now>end) { nextStart = new Date(start); nextStart.setDate(nextStart.getDate()+1); }
  return {open:false, opensIn: nextStart-now};
}

async function loadAll(){
  const [config, members, rentStatus, ebStatus, water, bookings, gatePassed, sessionMemberId, isAdminSession, food] = await Promise.all([
    sget('room-config', true),
    sget('members', true),
    sget('rent-status', true),
    sget('eb-status', true),
    sget('water-schedule', true),
    sget('parking-bookings', true),
    sget('gate-passed', false),
    sget('session-member', false),
    sget('session-admin', false),
    sget('food-items', true),
  ]);
  state.config = config;
  state.members = members || [];
  state.rentStatus = rentStatus || {};
  state.ebStatus = ebStatus || {};
  state.water = water || {};
  state.bookings = bookings || [];
  state.gatePassed = !!gatePassed;
  state.sessionMemberId = sessionMemberId;
  state.isAdminSession = !!isAdminSession;
  state.food = food || [];

  if(!config){ state.screen='setup'; }
  else if(!state.gatePassed){ state.screen='gate'; }
  else if(state.isAdminSession){ state.screen='admin'; state.tab = ['members','money','parking','water'].includes(state.tab) ? state.tab : 'members'; }
  else if(sessionMemberId && state.members.find(m=>m.id===sessionMemberId)){ state.screen='app'; }
  else{ state.screen='login'; }
  render();
}

function me(){ return state.members.find(m=>m.id===state.sessionMemberId); }

// ---------- render root ----------
function render(){
  const app = document.getElementById('app');
  if(state.screen==='setup') return app.innerHTML = renderSetup();
  if(state.screen==='gate') return app.innerHTML = renderGate();
  if(state.screen==='login') return app.innerHTML = renderLogin();
  if(state.screen==='app') return app.innerHTML = renderApp();
  if(state.screen==='admin') return app.innerHTML = renderAdminApp();
}

// ================= SETUP (first-ever, admin) =================
function renderSetup(){
  const rows = Array.from({length:12}).map((_,i)=>`
    <div class="setup-grid" style="margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid #ded6bc;">
      <input placeholder="Member ${i+1} name" id="su-name-${i}">
      <input placeholder="Mobile" id="su-mobile-${i}">
      <input placeholder="Username" id="su-user-${i}">
      <input placeholder="Password" id="su-pass-${i}">
    </div>
  `).join('');
  return `
  <div class="plaque">
    <div><h1>Set up the house board</h1><p>One-time setup — do this once for the flat</p></div>
    <div class="plaque-num"><span class="dot">👥</span>12</div>
  </div>
  <main>
    <div class="card">
      <h3>The basics</h3>
      <label>Flat / room name</label>
      <input id="su-roomname" placeholder="e.g. Flat 4B">
      <label>Total monthly rent (₹)</label>
      <input id="su-rent" type="number" placeholder="e.g. 25000">
      <p class="muted" style="margin:4px 0 0;">Split equally across all 12 members automatically.</p>
      <label>Total parking slots</label>
      <input id="su-slots" type="number" value="7">
      <div class="setup-grid" style="margin-top:2px;">
        <div>
          <label>Booking opens at</label>
          <input id="su-wstart" type="time" value="16:00">
        </div>
        <div>
          <label>Booking closes at</label>
          <input id="su-wend" type="time" value="16:50">
        </div>
      </div>
    </div>
    <div class="card">
      <h3>Admin account</h3>
      <p class="muted" style="margin-top:-6px;">This is separate from the 12 members below — nobody in the flat needs to know who holds it. Use it to manage rent, water, parking and bills.</p>
      <label>Admin username</label>
      <input id="su-admin-user" placeholder="e.g. houseadmin">
      <label>Admin password</label>
      <input id="su-admin-pass" type="password" placeholder="Choose a password">
    </div>
    <div class="card">
      <h3>All 12 members</h3>
      <p class="muted" style="margin-top:-4px;margin-bottom:10px;">Fill in everyone now — these are the 12 residents, not the admin.</p>
      ${rows}
    </div>
    <div id="su-err" class="err"></div>
    <button class="btn-primary" onclick="submitSetup()">Create the house board</button>
  </main>`;
}
async function submitSetup(){
  const roomName = document.getElementById('su-roomname').value.trim();
  const totalRent = Number(document.getElementById('su-rent').value);
  const slots = Number(document.getElementById('su-slots').value) || 7;
  const bookingStart = document.getElementById('su-wstart').value || '16:00';
  const bookingEnd = document.getElementById('su-wend').value || '16:50';
  const adminUsername = document.getElementById('su-admin-user').value.trim();
  const adminPassword = document.getElementById('su-admin-pass').value;
  if(!adminUsername || !adminPassword){
    document.getElementById('su-err').textContent = 'Set an admin username and password.';
    return;
  }
  const members = [];
  for(let i=0;i<12;i++){
    const name = document.getElementById(`su-name-${i}`).value.trim();
    const mobile = document.getElementById(`su-mobile-${i}`).value.trim();
    const username = document.getElementById(`su-user-${i}`).value.trim();
    const password = document.getElementById(`su-pass-${i}`).value;
    if(!name || !username || !password){
      document.getElementById('su-err').textContent = 'Every member needs at least a name, username and password.';
      return;
    }
    if(username.toLowerCase()===adminUsername.toLowerCase()){
      document.getElementById('su-err').textContent = 'A member username matches the admin username — pick a different one.';
      return;
    }
    members.push({
      id: 'm'+(i+1), name, mobile, username, password,
      fatherNumber:'', whatsapp:'', email:'',
      family: [], vehicles: []
    });
  }
  if(!roomName || !totalRent){
    document.getElementById('su-err').textContent = 'Add a flat name and rent amount.';
    return;
  }
  const config = { roomName, totalRent, totalSlots: slots, bookingStart, bookingEnd, adminUsername, adminPassword };
  await sset('room-config', config, true);
  await sset('members', members, true);
  await loadAll();
}

// ================= GATE (per device, before login) =================
function renderGate(){
  return `
  <div class="center-screen">
    <h1>Before you go in</h1>
    <p class="sub">${state.config.roomName} asks every visitor to leave a few details first.</p>
    <label>Name</label>
    <input id="g-name" placeholder="Your full name">
    <label>Mobile number</label>
    <input id="g-mobile" placeholder="Your mobile number">
    <label>Father's number</label>
    <input id="g-father" placeholder="Father's mobile number">
    <label>WhatsApp number</label>
    <input id="g-whatsapp" placeholder="WhatsApp number">
    <div id="g-err" class="err"></div>
    <button class="btn-primary" onclick="submitGate()">Continue</button>
  </div>`;
}
async function submitGate(){
  const name = document.getElementById('g-name').value.trim();
  const mobile = document.getElementById('g-mobile').value.trim();
  const father = document.getElementById('g-father').value.trim();
  const whatsapp = document.getElementById('g-whatsapp').value.trim();
  if(!name||!mobile||!father||!whatsapp){
    document.getElementById('g-err').textContent = 'Please fill in all four fields.';
    return;
  }
  const log = (await sget('entries-log', true)) || [];
  log.push({name, mobile, father, whatsapp, at: new Date().toISOString()});
  await sset('entries-log', log, true);
  await sset('gate-passed', true, false);
  state.gatePassed = true;
  state.screen = 'login';
  render();
}

// ================= LOGIN =================
function renderLogin(){
  if(loginMode==='admin'){
    return `
    <div class="center-screen">
      <h1>Admin login</h1>
      <p class="sub">${state.config.roomName}</p>
      <label>Admin username</label>
      <input id="a-user" placeholder="Admin username">
      <label>Admin password</label>
      <input id="a-pass" type="password" placeholder="Admin password">
      <div id="l-err" class="err"></div>
      <button class="btn-primary" onclick="submitAdminLogin()">Log in</button>
      <button class="btn-ghost" style="width:100%;margin-top:10px;" onclick="loginMode='member';render();">Back to member login</button>
    </div>`;
  }
  return `
  <div class="center-screen">
    <h1>${state.config.roomName}</h1>
    <p class="sub">Sign in with your house board account</p>
    <label>Username</label>
    <input id="l-user" placeholder="Username">
    <label>Password</label>
    <input id="l-pass" type="password" placeholder="Password">
    <div id="l-err" class="err"></div>
    <button class="btn-primary" onclick="submitLogin()">Log in</button>
    <p class="muted" style="text-align:center;margin-top:16px;"><a href="#" onclick="loginMode='admin';render();return false;" style="color:var(--ink-soft);">Admin login</a></p>
  </div>`;
}
async function submitLogin(){
  const u = document.getElementById('l-user').value.trim().toLowerCase();
  const p = document.getElementById('l-pass').value;
  const found = state.members.find(m=>m.username.toLowerCase()===u && m.password===p);
  if(!found){
    document.getElementById('l-err').textContent = 'Username or password not recognised.';
    return;
  }
  await sset('session-member', found.id, false);
  state.sessionMemberId = found.id;
  state.screen = 'app';
  state.tab = 'home';
  render();
}
async function submitAdminLogin(){
  const u = document.getElementById('a-user').value.trim().toLowerCase();
  const p = document.getElementById('a-pass').value;
  if(u !== state.config.adminUsername.toLowerCase() || p !== state.config.adminPassword){
    document.getElementById('l-err').textContent = 'Admin username or password not recognised.';
    return;
  }
  await sset('session-admin', true, false);
  state.isAdminSession = true;
  state.screen = 'admin';
  state.tab = 'members';
  render();
}
async function logout(){
  await sset('session-member', null, false);
  state.sessionMemberId = null;
  loginMode = 'member';
  state.screen = 'login';
  render();
}
async function logoutAdmin(){
  await sset('session-admin', false, false);
  state.isAdminSession = false;
  loginMode = 'member';
  state.screen = 'login';
  render();
}

// ================= MAIN APP SHELL (member) =================
function renderApp(){
  const m = me();
  const tabs = [
    ['home','Home','🏠'],
    ['parking','Parking','🚗'],
    ['money','Money','💰'],
    ['water','Water','💧'],
    ['profile','Profile','👤'],
  ];
  return `
  <div class="plaque">
    <div><h1>${state.config.roomName}</h1><p>Hi ${m.name.split(' ')[0]}</p></div>
    <div class="plaque-num"><span class="dot">🚗</span>${state.config.totalSlots} slots</div>
  </div>
  <main id="tab-content">${renderTab()}</main>
  <nav>
    ${tabs.map(([id,label,ic])=>`
      <button class="${state.tab===id?'active':''}" onclick="setTab('${id}')">
        <span class="ic">${ic}</span>${label}
      </button>`).join('')}
  </nav>`;
}
function setTab(t){ state.tab = t; render(); if(t==='parking') startParkingTimer(); }

function renderTab(){
  if(state.tab==='home') return renderHome();
  if(state.tab==='parking') return renderParking();
  if(state.tab==='money') return renderMoney();
  if(state.tab==='water') return renderWater();
  if(state.tab==='profile') return renderProfile();
}

// ---------- HOME ----------
function perPersonRent(){
  const total = state.config.totalRent || 0;
  const n = state.members.length || 1;
  return total / n;
}
function fmtMoney(n){
  return '₹' + Math.round(n).toLocaleString('en-IN');
}
function renderHome(){
  const m = me();
  const key = m.id+'-'+todayKey();
  const paid = !!(state.rentStatus[key] && state.rentStatus[key].paid);
  const todayName = WEEKDAYS[(new Date().getDay()+6)%7];
  const duty = state.water[todayName] || [];
  const dutyNames = duty.map(id=>state.members.find(x=>x.id===id)?.name).filter(Boolean);
  const myBooking = state.bookings.find(b=>b.memberId===m.id && b.weekStart===nextMondayISO());
  const win = bookingWindowInfo();

  return `
    <div class="card">
      <h3>This month's rent</h3>
      <div class="row">
        <span>${fmtMoney(perPersonRent())} <span class="muted">your share</span></span>
        <span class="badge ${paid?'paid':'unpaid'}">${paid?'Paid':'Not paid'}</span>
      </div>
    </div>
    <div class="card">
      <h3>Water duty today (${todayName})</h3>
      <p style="margin:0;">${dutyNames.length ? dutyNames.join(' & ') : 'Not assigned yet'}</p>
    </div>
    <div class="card">
      <h3>Parking</h3>
      ${myBooking
