// ---------- PARKING ----------
let parkingTimerHandle = null;
function startParkingTimer(){
  if(parkingTimerHandle) clearInterval(parkingTimerHandle);
  parkingTimerHandle = setInterval(()=>{
    if(state.tab==='parking'){
      const el = document.getElementById('parking-countdown');
      if(el){
        const win = bookingWindowInfo();
        el.textContent = win.open ? fmtCountdown(win.closesIn) : fmtCountdown(win.opensIn);
      } else {
        clearInterval(parkingTimerHandle);
      }
    } else {
      clearInterval(parkingTimerHandle);
    }
  }, 1000);
}
function renderParking(){
  const win = bookingWindowInfo();
  const week = nextMondayISO();
  const myExisting = state.bookings.find(b=>b.memberId===me().id && b.weekStart===week);

  // ---- Confirmation card: shown whenever the member already holds a slot,
  // whether the booking window is currently open or closed. This is the
  // "after you've booked" state.
  const confirmCard = myExisting ? `
    <div class="card" style="border-left:4px solid var(--paid);">
      <div class="row">
        <h3 style="margin:0;">You're booked ✓</h3>
        <span class="badge paid">Confirmed</span>
      </div>
      <p style="margin:10px 0 2px;font-family:'Roboto Slab',serif;font-size:22px;">Slot #${myExisting.slotNumber}</p>
      <p class="muted" style="margin:0 0 12px;">Week of ${myExisting.weekStart} · booked ${new Date(myExisting.bookedAt).toLocaleString([], {weekday:'short', hour:'2-digit', minute:'2-digit'})}</p>
      <button class="btn-ghost" style="width:100%;color:#8a3126;border-color:#8a3126;" onclick="cancelBooking('${myExisting.bookingId}')">Cancel my booking</button>
    </div>` : '';

  if(!win.open){
    return `
    ${confirmCard}
    <div class="card" style="text-align:center;">
      <h3>${myExisting ? 'Booking window is closed' : 'Booking is closed'}</h3>
      <p class="muted">Slots open for booking each day from ${state.config.bookingStart} to ${state.config.bookingEnd}.</p>
      <p style="font-family:'Roboto Slab',serif;font-size:26px;margin:14px 0 2px;" id="parking-countdown">${fmtCountdown(win.opensIn)}</p>
      <p class="muted" style="margin:0;">until booking opens</p>
    </div>`;
  }

  const slots = Array.from({length: state.config.totalSlots}).map((_,i)=>{
    const num = i+1;
    const taken = state.bookings.find(b=>b.slotNumber===num && b.weekStart===week);
    const takenBy = taken ? state.members.find(m=>m.id===taken.memberId) : null;
    const isMine = taken && taken.memberId===me().id;
    const canBook = !taken && !myExisting;
    return `
      <div class="slot-card ${taken?'taken':''}" ${isMine?'style="border-color:var(--paid);"':''}>
        <div class="num">#${num}</div>
        ${taken
          ? `<p class="muted" style="margin:6px 0 0;">${isMine?'You':(takenBy?takenBy.name:'Taken')}</p>`
          : canBook
            ? `<button class="btn-small btn-primary" style="margin-top:8px;padding:8px;" onclick="bookSlot(${num})">Book</button>`
            : `<p class="muted" style="margin:6px 0 0;">Free</p>`
        }
      </div>`;
  }).join('');

  return `
    ${confirmCard}
    <div class="card">
      <div class="row">
        <h3 style="margin:0;">Slots for week of ${week}</h3>
        <span id="parking-countdown" class="muted">${fmtCountdown(win.closesIn)}</span>
      </div>
      <p class="muted" style="margin:8px 0 12px;">${myExisting ? 'You already hold a slot this week — see above.' : 'One slot per person, per week.'}</p>
      <div class="slot-grid">${slots}</div>
    </div>`;
}
async function bookSlot(num){
  const week = nextMondayISO();
  const bookings = (await sget('parking-bookings', true)) || [];
  const conflict = bookings.find(b=>b.slotNumber===num && b.weekStart===week);
  const already = bookings.find(b=>b.memberId===me().id && b.weekStart===week);
  if(conflict || already){ state.bookings = bookings; render(); return; }
  bookings.push({bookingId:'b'+Date.now(), memberId: me().id, slotNumber:num, weekStart:week, bookedAt:new Date().toISOString()});
  const ok = await sset('parking-bookings', bookings, true);
  if(ok) state.bookings = bookings;
  render();
  startParkingTimer();
}
async function cancelBooking(bookingId){
  const bookings = (await sget('parking-bookings', true)) || [];
  const b = bookings.find(x=>x.bookingId===bookingId);
  if(!b) return;
  const mine = me() && b.memberId === me().id;
  if(!mine && !isAdminNow()) return;
  const next = bookings.filter(x=>x.bookingId!==bookingId);
  const ok = await sset('parking-bookings', next, true);
  if(ok) state.bookings = next;
  render();
  startParkingTimer();
}

