    return `
      <div class="weekday-row">
        <span class="day">#${num}</span>
        <select style="flex:1;" onchange="adminSetSlot(${num}, this.value)">
          ${slotOptions(booking ? booking.memberId : null)}
        </select>
      </div>`;
  }).join('');

  return `
    <div class="card">
      <h3>Parking overrides — week of ${week}</h3>
      <p class="muted" style="margin-top:-6px;">Reassign any slot manually, bypassing the booking window.</p>
      <div class="divider"></div>
      ${slotRows}
    </div>
  `;
}
async function adminSetSlot(num, memberId){
  if(!isAdminNow()) return;
  const week = nextMondayISO();
  let bookings = (await sget('parking-bookings', true)) || [];
  // clear this slot for the week, and clear this member's other booking that week (one slot per person)
  bookings = bookings.filter(b => !(b.slotNumber===num && b.weekStart===week));
  if(memberId){
    bookings = bookings.filter(b => !(b.memberId===memberId && b.weekStart===week));
    bookings.push({bookingId:'b'+Date.now(), memberId, slotNumber:num, weekStart:week, bookedAt:new Date().toISOString()});
  }
  const ok = await sset('parking-bookings', bookings, true);
  if(ok) state.bookings = bookings;
  render();
}

// Watchdog: if we're somehow still stuck on the initial loading screen
// after 10s (e.g. storage backend totally unresponsive), stop waiting
// and offer a manual retry instead of a dead blank page forever.
setTimeout(()=>{
  const stillLoading = document.getElementById('initial-loading');
  if(stillLoading){
    document.getElementById('app').innerHTML = `
      <div class="center-screen">
        <h1>Taking longer than usual</h1>
        <p class="sub">The connection to the house board is slow right now. This usually clears up in a moment.</p>
        <button class="btn-primary" onclick="location.reload()">Retry</button>
      </div>`;
  }
}, 10000);

loadAll().catch(()=>{
  document.getElementById('app').innerHTML = `
    <div class="center-screen">
      <h1>Something went wrong</h1>
      <p class="sub">The house board couldn't load. Try again.</p>
      <button class="btn-primary" onclick="location.reload()">Retry</button>
    </div>`;
});
</script>
